{
  "expo": {
    "name": "RiyadusSalihin",
    "slug": "riyadusalihin",
    "version": "1.0.0",
     "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpg",
    "scheme": "riyadussalihinapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.jpg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.jpg",
        "backgroundImage": "./assets/images/android-icon-background.jpg",
        "monochromeImage": "./assets/images/android-icon-monochrome.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amirtofik.riyadussalihin"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.jpg",
          "imageWidth": 76
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-audio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e710b932-f7a1-4fdc-b3f4-d879b4a6222a"
      }
    },
    "owner": "amirhumdevs-team"
  }
}
